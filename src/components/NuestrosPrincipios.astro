---
import { Sparkles, ShieldCheck, Flame, HeartHandshake } from "lucide-react";

const pilares = [
  { letter: "E", word: "Experiencia", desc: "Años de trayectoria al servicio de la familia universitaria", Icon: Sparkles },
  { letter: "R", word: "Responsabilidad", desc: "Gestión transparente y compromiso con cada decisión", Icon: ShieldCheck },
  { letter: "E", word: "Esfuerzo", desc: "Trabajo constante para alcanzar metas que benefician a todos", Icon: Flame },
  { letter: "S", word: "Servicio", desc: "Estudiante, docente y administrativo siempre en primer lugar", Icon: HeartHandshake },
];
---

<section id="nuestros-principios" class="relative overflow-hidden bg-white">
  <div class="relative z-10 mx-auto max-w-[96rem] px-4 py-20 sm:px-8 sm:py-32 lg:px-12 xl:px-16">
    <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto] lg:gap-12">

      <!-- ─── Izquierda: Acrónimo + Pilares ─── -->
      <div class="animate-fade-in-up">
        <div class="mb-10">
          <h2 class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
            El acrónimo <span class="animate-gradient-text">ERES</span>
          </h2>
          <p class="mt-4 text-base font-normal leading-relaxed max-w-lg sm:mt-6 sm:text-lg text-muted-foreground">
            Cada letra de nuestro nombre refleja un compromiso real con la{" "}
            <span class="text-foreground font-bold">Universidad Nacional de Cajamarca</span>.
          </p>
        </div>

        <!-- Card ERES -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-5">
            {pilares.map((p, i) => (
              <div
                class="group relative flex flex-col items-center text-center px-3 py-3 sm:px-4 sm:py-4 lg:px-5 lg:py-5 aspect-square animate-fade-in-up rounded-2xl border border-sky-200/60 bg-white shadow-sm"
                style={`animation-delay: ${200 + i * 80}ms`}
              >
                <p.Icon className="absolute inset-0 m-auto h-36 w-36 sm:h-40 sm:w-40 text-sky-600/5 transition-all duration-700 group-hover:text-sky-600/10 group-hover:scale-110" />
                <div class="flex flex-col justify-center flex-1 w-full">
                  <div class="flex items-center justify-center">
                    <span class="block font-heading text-[38px] sm:text-[44px] font-black animate-gradient-text">
                      {p.letter}
                    </span>
                  </div>
                </div>
                <div class="shrink-0">
                  <h3 class="text-sm sm:text-base font-bold text-sky-600 dark:text-sky-400">{p.word}</h3>
                  <p class="mt-0.5 text-sm sm:text-base leading-relaxed text-muted-foreground">{p.desc}</p>
                </div>
              </div>
            ))}
        </div>
      </div>

      <!-- ─── Derecha: Mascota ─── -->
      <div class="flex flex-col items-center gap-3 animate-fade-in-up" style="animation-delay: 400ms">
        <p class="text-center font-heading text-sm sm:text-base font-bold text-sky-600 dark:text-sky-400">
          ¡Saluda a <span class="text-sky-700 dark:text-sky-300">Yupi</span>, la mascota oficial!
        </p>
        <img
          src="/yupi-pixel1-sin fondo.png"
          alt="Yupi mascota ERES UNC"
          class="w-full max-w-[264px] sm:max-w-[312px] h-auto object-contain"
        />
      </div>

    </div>
  </div>
</section>
